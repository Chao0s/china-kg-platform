# Normalize line endings to LF in the repository for cross-platform consistency.
* text=auto eol=lf

# Shell hooks must stay LF (they run under sh, including on Windows git).
*.sh text eol=lf
.githooks/* text eol=lf

# Windows launchers keep CRLF. Teammates double-click these on Windows, and a
# .bat with LF endings can misbehave in cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary (no diff/eol munging).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
